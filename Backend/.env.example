# Local development defaults. This file is safe to copy to .env.
APP_ENV=local
APP_NAME=Firefighter Safety Data Hub
API_V1_PREFIX=/api/v1

# SQLite requires no database server. Use an absolute or relative file path.
DATABASE_URL=sqlite:///./firefighter_local.db

# Local-only values. Generate strong, private values for any real deployment.
SECRET_KEY=local-development-secret-change-for-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
EMAIL_TOKEN_SECRET=local-development-email-secret

# Console mode prints messages and verification tokens in the backend terminal.
EMAIL_BACKEND=console
SES_REGION=us-east-1
SES_FROM_NAME=Firefighter Data Hub
SES_FROM_EMAIL=noreply@localhost
EMAIL_VERIFICATION_MODE=manual
FRONTEND_VERIFY_BASE_URL=
WEB_FRONTEND_BASE_URL=http://localhost:5173

# Local uploads are stored under Backend/local_uploads by default.
FILE_STORAGE_BACKEND=local
LOCAL_UPLOAD_DIR=local_uploads

# Browser development origins. "*" is acceptable for local testing only.
CORS_ORIGINS=*

# Optional production overrides (leave blank for local development).
AWS_REGION=us-east-1
S3_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
